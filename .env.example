# Modelo — copie para .dev.vars (dev do wrangler) ou configure como secrets em
# produção via `npx wrangler secret put`. Nada aqui vai para o cliente/bundle.

# URL do webhook externo que recebe os leads do formulário de diagnóstico
N8N_WEBHOOK_URL_DIAGNOSTICO=

# Token anti-spam (mesmo valor validado no lado do webhook)
FORM_TOKEN=
